# ============================================================
#  Prod-Konfiguration für n8n auf Hostinger VPS
#  Kopieren:  cp .env.example .env   →  dann echte Werte eintragen
#  NIEMALS die ausgefüllte .env committen!
# ============================================================

# Subdomain, unter der n8n erreichbar sein soll.
# Muss per DNS A-Record auf die IP deines VPS zeigen.
N8N_HOST=n8n.deine-domain.de

# E-Mail für Let's Encrypt (Zertifikats-Benachrichtigungen).
ACME_EMAIL=dominik.nees@icloud.com

# Slack Incoming Webhook URL
# https://api.slack.com/apps → deine App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ

# OpenRouter API Key (für die LLM-Analyse im Workflow)
# https://openrouter.ai/keys  (Format: sk-or-v1-...)
OPENROUTER_API_KEY=sk-or-v1-DEIN_KEY_HIER
