# Kopiere diese Datei: cp .env.example .env
# Trage dann deine echten Werte ein.
# WICHTIG: .env niemals in Git committen!

# OpenRouter API Key (für LLM-Analyse/STT in den aktuellen Workflows)
OPENROUTER_API_KEY=sk-or-v1-DEIN_OPENROUTER_KEY_HIER

# Optionaler OpenAI-Fallback für ältere Workflows
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-DEIN_OPENAI_KEY_HIER

# Slack Incoming Webhook URL (z. B. HR-Workflow)
# https://api.slack.com/apps → deine App → Incoming Webhooks
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/YYYYY/ZZZZZ

# Optional: eigener Slack Incoming Webhook für Lieferdienst-Bestellungen
SLACK_ORDERS_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/YYYYY/ORDERS

# Optional: bevorzugter Slack Incoming Webhook fuer den Channel #test-channel-steinofen-bot
SLACK_STEINOFENBOT_WEBHOOK_URL=https://hooks.slack.com/services/XXXXX/YYYYY/STEINOFENBOT
SLACK_ORDERS_CHANNEL=#test-channel-steinofen-bot

# Optional: PDF-Speisekarte, die der Telegram-Bot bei Speisekartenfragen sendet
MENU_PDF_URL=https://example.com/speisekarte.pdf

# n8n öffentliche Webhook-URL (ngrok-URL wenn lokal)
# Beispiel: https://abc123.ngrok-free.app/
# Diese URL muss auch in Vapi als Server-URL eingetragen werden.
N8N_WEBHOOK_URL=https://DEINE-NGROK-URL.ngrok-free.app/
